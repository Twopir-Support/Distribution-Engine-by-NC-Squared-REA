<messaging:emailTemplate subject="You were added as {!relatedTo.Team_Role__c}: {!relatedTo.Record_Name__c}" recipientType="User" relatedToType="DE_Assignment_Log__c">
    <messaging:htmlEmailBody>
        <c:DE_EmailNotification log="{!relatedTo}" headline="You have been added to the {!relatedTo.Object_API_Name__c} team as {!relatedTo.Team_Role__c}." />
    </messaging:htmlEmailBody>
    <messaging:plainTextEmailBody>
You have been added to the {!relatedTo.Object_API_Name__c} team as {!relatedTo.Team_Role__c}.
{!relatedTo.Record_Name__c}
{!LEFT($Api.Partner_Server_URL_660, FIND('/services', $Api.Partner_Server_URL_660))}{!relatedTo.Record_Id__c}
    </messaging:plainTextEmailBody>
</messaging:emailTemplate>
