<messaging:emailTemplate subject="{!relatedTo.Object_API_Name__c} assigned to you: {!relatedTo.Record_Name__c}" recipientType="User" relatedToType="DE_Assignment_Log__c">
    <messaging:htmlEmailBody>
        <c:DE_EmailNotification log="{!relatedTo}" headline="A {!relatedTo.Object_API_Name__c} has been assigned to you{!IF(ISBLANK(relatedTo.Team__c), '', ' by the ' + relatedTo.Team__r.Name + ' team')}." />
    </messaging:htmlEmailBody>
    <messaging:plainTextEmailBody>
A {!relatedTo.Object_API_Name__c} has been assigned to you{!IF(ISBLANK(relatedTo.Team__c), '', ' by the ' + relatedTo.Team__r.Name + ' team')}.
{!relatedTo.Record_Name__c}
{!LEFT($Api.Partner_Server_URL_660, FIND('/services', $Api.Partner_Server_URL_660))}{!relatedTo.Record_Id__c}
    </messaging:plainTextEmailBody>
</messaging:emailTemplate>
