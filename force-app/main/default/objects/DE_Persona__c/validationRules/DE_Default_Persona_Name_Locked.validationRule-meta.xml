<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DE_Default_Persona_Name_Locked</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Is_Default__c, ISCHANGED(Name))</errorConditionFormula>
    <errorDisplayField>Name</errorDisplayField>
    <errorMessage>The default persona cannot be renamed.</errorMessage>
</ValidationRule>
