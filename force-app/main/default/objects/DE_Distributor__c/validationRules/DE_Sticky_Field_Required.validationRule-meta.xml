<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DE_Sticky_Field_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Sticky_Enabled__c, ISBLANK(Sticky_Field__c))</errorConditionFormula>
    <errorDisplayField>Sticky_Field__c</errorDisplayField>
    <errorMessage>Choose a sticky match field.</errorMessage>
</ValidationRule>
