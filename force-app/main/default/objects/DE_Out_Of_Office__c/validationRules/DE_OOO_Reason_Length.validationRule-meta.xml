<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DE_OOO_Reason_Length</fullName>
    <active>true</active>
    <errorConditionFormula>LEN(Reason__c) &gt; 80</errorConditionFormula>
    <errorDisplayField>Reason__c</errorDisplayField>
    <errorMessage>Reason is limited to 80 characters.</errorMessage>
</ValidationRule>
